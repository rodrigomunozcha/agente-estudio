#!/bin/bash
# Pausa antes de cada commit para mostrar que se va a subir, agrupado por
# carpeta, y pedir una confirmacion deliberada.
#
# Existe porque un "git add -A" amplio metio 848 lineas de trabajo de un dia
# entero (el respaldo del titulo, el gate de rutas, el manejo de errores del
# SDK, el veredicto de la revision, 549 lineas de pruebas) dentro de un commit
# que solo hablaba de fechas de archivo (911e2c6, 21-08-2026). Nadie lo noto
# porque nadie miro la lista de archivos antes de confirmar.
#
# No intenta adivinar si un commit mezcla temas: se probo contra los commits
# reales de este repo y ni la cantidad de archivos ni las lineas cambiadas son
# una señal confiable. El commit problematico (13 archivos, 1039 lineas) es
# mas chico que dos commits legitimos de un solo tema (18 archivos/1901
# lineas, y 16 archivos/1141 lineas). Un tope por tamaño habria bloqueado
# trabajo bueno sin bloquear el malo.
#
# Por eso esto solo garantiza una cosa: que alguien mire la lista completa
# antes de que el commit se confirme. Aplica siempre, sin excepcion por
# tamaño, porque ya se demostro que "chico" no es lo mismo que "seguro".
#
# Para activarlo (una vez, despues de clonar el repo):
#   git config core.hooksPath .githooks

set -euo pipefail

archivos=$(git diff --cached --name-only)
if [ -z "$archivos" ]; then
    exit 0
fi

# Las pruebas corren antes que todo: tardan menos de dos segundos y sin repositorio
# remoto no hay CI que las corra despues. Se sumaron el 05-10-2026, cuando se vio
# que la copia "Agente estudio" llevaba mas de diez commits sin este hook activo.
#
# Las pruebas corren sin las variables GIT_* que git exporta dentro de un hook. El
# 15-10-2026, en un worktree, una prueba hizo git init en una carpeta temporal,
# heredo GIT_DIR y reinicializo el repo real, que quedo marcado como bare: ninguna
# carpeta de trabajo volvio a funcionar hasta corregirlo a mano. Se arreglo esa
# prueba, y esto cubre a la siguiente que llame a git.
raiz=$(git rev-parse --show-toplevel)
if [ -f "$raiz/tests/test_orquestador.py" ] && ! salida=$(cd "$raiz" && unset $(env | grep -o '^GIT_[A-Z_]*') && /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 tests/test_orquestador.py 2>&1); then
    echo ""
    echo "Commit detenido: fallan las pruebas."
    echo "$salida" | grep -E "FALLA|FALLARON|Error|Traceback" | head -20
    echo ""
    echo "Corre tests/test_orquestador.py para ver el detalle."
    exit 1
fi

# Nombres indefinidos o sin usar en los .py del commit (reglas F de ruff). Un import que
# falta dentro de una prueba solo se veia al correrla: el 14-10-2026 costo tres corridas.
# Sin ruff instalado se avisa y se sigue, para no frenar un clon nuevo por una herramienta.
py="/Library/Frameworks/Python.framework/Versions/3.13/bin/python3"
archivos_py=$(git diff --cached --name-only --diff-filter=d -- '*.py')
if [ -n "$archivos_py" ]; then
    if "$py" -m ruff --version >/dev/null 2>&1; then
        if ! salida=$(cd "$raiz" && echo "$archivos_py" | tr '\n' '\0' | xargs -0 "$py" -m ruff check --select F --output-format concise 2>&1); then
            echo ""
            echo "Commit detenido: ruff encontró nombres indefinidos o sin usar."
            echo "$salida" | head -20
            echo ""
            echo "Los sin usar se arreglan con: $py -m ruff check --select F --fix <archivo>"
            exit 1
        fi
    else
        echo "Aviso: ruff no está instalado, no se revisaron nombres indefinidos. Instálalo con: $py -m pip install ruff"
    fi
fi

# Las rutas propias de este Mac no salen del Mac. Una ruta absoluta con el
# usuario real dice el nombre de quien lo usa y como tiene ordenado el
# computador, y la copia original de este repo es publica. Pasa sin querer: una ruta copiada en un
# comentario o en la documentacion. Idea tomada del repo ECC
# (scripts/ci/validate-no-personal-paths.js), auditado el 03-10-2026.
#
# Solo mira las lineas que este commit agrega, no los archivos completos: lo
# ya publicado no se arregla frenando un commit que no lo toca. Deja pasar
# /Users/tu_usuario, que es el ejemplo de config.example.json, y /Users/Shared,
# que existe igual en todos los Mac. Frena siempre, haya terminal o no, porque
# aqui no hay nada que confirmar: la ruta se cambia y se vuelve a intentar.
hallazgos=$(git diff --cached -U0 --no-color --no-ext-diff | awk '
    /^\+\+\+ / { archivo = substr($0, 7); next }
    /^@@/ { split($3, a, ","); linea = substr(a[1], 2); next }
    /^\+/ {
        # Un nombre de usuario de macOS solo lleva letras, numeros, "_", "-"
        # y ".". Un punto al final es puntuacion de la frase, no del nombre.
        if (match($0, /\/Users\/[A-Za-z0-9_.-]+/)) {
            ruta = substr($0, RSTART, RLENGTH)
            sub(/\.+$/, "", ruta)
            if (ruta != "/Users/tu_usuario" && ruta != "/Users/Shared")
                print "    " archivo ", linea " linea ": " ruta
        }
        linea++
    }')
if [ -n "$hallazgos" ]; then
    echo ""
    echo "Commit detenido: estos cambios traen una ruta de este Mac con tu"
    echo "nombre de usuario, y esas rutas no salen de este Mac."
    echo ""
    echo "$hallazgos"
    echo ""
    echo "Cambiala por /Users/tu_usuario/... o por ~/..., guarda el archivo,"
    echo "vuelve a hacer git add y repite el commit."
    exit 1
fi

echo ""
echo "Este commit va a incluir:"
echo "$archivos" | awk -F'/' '
    { if (NF==1) { area="(raiz)" }
      else { area=$1; for (i=2; i<NF; i++) area = area "/" $i }
      print area
    }' | sort | uniq -c | sort -rn | while read -r cantidad carpeta; do
    printf "  %2d archivo(s) en %s\n" "$cantidad" "$carpeta"
done
echo ""
echo "$archivos" | sed 's/^/    /'
echo ""

if [ -t 0 ]; then
    read -r -p "¿Es esto un solo tema coherente? [s/N] " respuesta
    case "$respuesta" in
        [sS]|[sS][iI])
            exit 0
            ;;
        *)
            echo "Commit cancelado. Revisa si hiciste 'git add' de mas."
            exit 1
            ;;
    esac
else
    # Sin terminal interactiva (por ejemplo, una sesion de Claude Code que
    # corre git commit por su cuenta) no hay a quien preguntarle. Se exige un
    # gesto explicito en vez de dejar pasar en silencio: la misma idea, que
    # nadie confirme sin haber mirado, adaptada a que aqui no hay quien mire.
    if [ "${CONFIRMO_COMMIT:-}" = "1" ]; then
        exit 0
    fi
    echo "No hay terminal interactiva para confirmar esto (por ejemplo, una"
    echo "sesion de Claude Code corriendo el commit). Revisa la lista de"
    echo "arriba. Si de verdad es un solo tema, repite el commit con:"
    echo ""
    echo "    CONFIRMO_COMMIT=1 git commit ..."
    exit 1
fi
